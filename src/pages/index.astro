---
import TempToggle from '../components/TempToggle.astro';
import InputButton from '../components/InputButton.astro';
import HourlyForecast from '../components/HourlyForecast.astro';
import WeeklyForecast from '../components/WeeklyForecast.astro';
import '../styles/global.scss';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Weather App</title>
	</head>
	<body>
		<div class="app-container">
			<header class="app-header">
				<p class="app-label">Weather App</p>
				<TempToggle />
			</header>

			<!-- Grid area: on desktop = [sidebar (weekly)] [main (search + hourly)] -->
			<div class="app-grid">
				<!-- Sidebar: weekly forecast — left on desktop, bottom on mobile -->
				<aside class="col-sidebar">
					<WeeklyForecast />
				</aside>

				<!-- Main column: search + current weather + hourly forecast -->
				<main class="col-main">
					<section class="search-section">
						<InputButton placeholder="Search city…" buttonText="Search" />
					</section>
					<div class="hourly-wrapper">
						<HourlyForecast />
					</div>
				</main>
			</div>
		</div>
	</body>
</html>

<style>
	/* ═══════════════════════════════════════════════════════════════
	   BASE — mobile-first (applies to mobile + tablet)
	═══════════════════════════════════════════════════════════════ */
	.app-container {
		width: 100%;
		max-width: 560px;
		margin: 0 auto;
		padding: 24px 16px 56px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.app-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.app-label {
		font-size: 2.8rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: #1c1c1e;
		margin: 0;
	}

	/* Grid: single column on mobile/tablet.
	   col-main first, col-sidebar (weekly) second. */
	.app-grid {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.col-main {
		order: 1;
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 0;
	}

	.col-sidebar {
		order: 2;
		min-width: 0;
	}

	.search-section {
		display: flex;
		flex-direction: column;
	}

	.hourly-wrapper {
		/* no extra styles needed on mobile */
	}

	/* ═══════════════════════════════════════════════════════════════
	   DESKTOP — above 1024px
	   Layout: [weekly sidebar left] | [search + hourly right]
	   Header spans full width above the grid
	═══════════════════════════════════════════════════════════════ */
	@media (min-width: 1025px) {
		.app-container {
			max-width: 1080px;
			padding: 48px 40px 80px;
			gap: 24px;
		}

		/* 2-column grid: main (wider) | weekly sidebar (narrower) */
		.app-grid {
			display: grid;
			grid-template-columns: 1fr 300px;
			grid-template-rows: auto;
			gap: 24px;
			align-items: start;
		}

		/* Main (search + hourly) → left column */
		.col-main {
			order: 1;
			grid-column: 1;
			gap: 16px;
		}

		/* Sidebar (weekly) → right column */
		.col-sidebar {
			order: 2;
			grid-column: 2;
		}
	}
</style>

